<Window x:Class="eBayHero.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eBay Hero Settings" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="ModernWindow"/>
    </Window.Style>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}" Width="80" Margin="0,0,8,0" Style="{StaticResource ModernButton}"/>
            <Button Content="Close" Click="CloseButton_Click" Width="80" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>

        <TabControl Style="{StaticResource ModernTabControl}">
            <TabItem Header="User Settings" Style="{StaticResource ModernTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="Directory Paths" Margin="0,0,0,16" Style="{StaticResource ModernGroupBox}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,6,8,6" Text="Source Root:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,6,8,6" Text="{Binding SourceRoot, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Command="{Binding BrowseSourceRootCommand}" Width="80" Margin="0,6,0,6" Style="{StaticResource SecondaryButton}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,8,6" Text="Operations Root:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,8,6" Text="{Binding OperationsRoot, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Command="{Binding BrowseOperationsRootCommand}" Width="80" Margin="0,6,0,6" Style="{StaticResource SecondaryButton}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,8,6" Text="Tesseract Path:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6,8,6" Text="{Binding TesseractPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Command="{Binding BrowseTesseractCommand}" Width="80" Margin="0,6,0,6" Style="{StaticResource SecondaryButton}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="OCR Settings" Margin="0,0,0,16" Style="{StaticResource ModernGroupBox}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,6,8,6" Text="Language:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,6,0,6" Text="{Binding OcrLanguage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,8,6" Text="Min Confidence:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,6" Text="{Binding OcrMinimumConfidence, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="AI Configuration" Margin="0,0,0,16" Style="{StaticResource ModernGroupBox}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,6,8,6" Text="OpenAI API Key:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <PasswordBox Grid.Row="0" Grid.Column="1" Margin="0,6,0,6" x:Name="OpenAiKeyBox" PasswordChanged="OpenAiKeyBox_PasswordChanged" Style="{StaticResource ModernPasswordBox}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,8,6" Text="Local AI Endpoint:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,6" Text="{Binding LocalAiEndpoint, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                            </Grid>
                        </GroupBox>

                        <TextBlock Text="Changes will take effect after restarting the application." 
                                   FontStyle="Italic" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Developer Settings" Style="{StaticResource ModernTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <CheckBox Content="Show Developer Settings" 
                                  IsChecked="{Binding ShowDeveloperSettings}" 
                                  Margin="0,0,0,16"
                                  Style="{StaticResource ModernCheckBox}"/>

                        <GroupBox Header="Developer Paths" Margin="0,0,0,16" Style="{StaticResource ModernGroupBox}" Visibility="{Binding ShowDeveloperSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,6,8,6" Text="Database Path:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,6,0,6" Text="{Binding DevDatabasePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,8,6" Text="Log Path:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,6" Text="{Binding DevLogPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Developer Options" Margin="0,0,0,16" Style="{StaticResource ModernGroupBox}" Visibility="{Binding ShowDeveloperSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Row="0" Grid.Column="0" 
                                          Content="Enable Debug Logging" 
                                          IsChecked="{Binding DevEnableDebugLogging}" 
                                          Margin="0,6,8,6"
                                          Style="{StaticResource ModernCheckBox}"/>
                            </Grid>
                        </GroupBox>

                        <TextBlock Text="Developer settings are for advanced configuration and troubleshooting." 
                                   FontStyle="Italic" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>