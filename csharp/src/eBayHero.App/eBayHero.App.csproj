<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\eBayHero.Core\eBayHero.Core.csproj" />
    <ProjectReference Include="..\eBayHero.Infrastructure\eBayHero.Infrastructure.csproj" />
    <ProjectReference Include="..\eBayHero.FileSystem\eBayHero.FileSystem.csproj" />
    <ProjectReference Include="..\eBayHero.Ocr\eBayHero.Ocr.csproj" />
    <ProjectReference Include="..\eBayHero.Export\eBayHero.Export.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ProductFlavor Condition="'$(ProductFlavor)' == ''">Public</ProductFlavor>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ProductFlavor)' == 'Development'">
    <DefineConstants>$(DefineConstants);DEVELOPER_BUILD</DefineConstants>
    <AssemblyName>eBay-Assistance-Development</AssemblyName>
  </PropertyGroup>

</Project>