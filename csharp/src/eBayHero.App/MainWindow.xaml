<Window x:Class="eBayHero.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eBay-Hero" Height="720" Width="1200" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Style>
        <StaticResource ResourceKey="ModernWindow"/>
    </Window.Style>
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="120">
                    <WrapPanel>
                        <Button Content="Refresh" Command="{Binding InitializeCommand}" Style="{StaticResource ModernButton}"/>
                        <Button Content="Dry-run migration" Command="{Binding DryRunMigrationCommand}" Style="{StaticResource ModernButton}"/>
                        <Button Content="Scan roots" Command="{Binding ScanRootsCommand}" Style="{StaticResource ModernButton}"/>
                        <Button Content="Dedupe scan" Command="{Binding DedupeScanCommand}" Style="{StaticResource ModernButton}"/>
                        <Button Content="OCR selected" Command="{Binding OcrSelectedCommand}" Style="{StaticResource ModernButton}"/>
                        <Button Content="OCR highlighted" Command="{Binding OcrHighlightedRegionCommand}" Style="{StaticResource ModernButton}"/>
                        <Button Content="Apply metadata edits" Command="{Binding ApplyMetadataToSelectedImagesCommand}" Style="{StaticResource ModernButton}"/>
                        <Button Content="Auto sort categorized" Command="{Binding AutoSortCategorizedPhotosCommand}" Style="{StaticResource ModernButton}"/>
                        <Button Content="Auto A/B/C" Command="{Binding AssignAutoRoleCodesCommand}" Style="{StaticResource ModernButton}"/>
                        <Button Content="Front A" Command="{Binding AssignFrontRoleCodesCommand}" Style="{StaticResource ModernButton}"/>
                        <Button Content="Rear B" Command="{Binding AssignRearRoleCodesCommand}" Style="{StaticResource ModernButton}"/>
                        <Button Content="Next C-Z" Command="{Binding AssignNextAdditionalRoleCodesCommand}" Style="{StaticResource ModernButton}"/>
                        <Button Content="Corner CS" Command="{Binding AssignCornerRoleCodesCommand}" Style="{StaticResource ModernButton}"/>
                        <Button Content="Damage Dd" Command="{Binding AssignDamageRoleCodesCommand}" Style="{StaticResource ModernButton}"/>
                        <Button Content="Export selected" Command="{Binding ExportSelectedCommand}" Style="{StaticResource ModernButton}"/>
                        <Button Content="Database check" Command="{Binding DatabaseCheckCommand}" Style="{StaticResource ModernButton}"/>
                        <Button Content="Settings" Click="SettingsButton_Click" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="Collect diagnostics" Command="{Binding CollectDiagnosticsCommand}" Style="{StaticResource ModernButton}"/>
                        <TextBox Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                        <CheckBox Margin="15,7,0,0" Content="Only not listed" IsChecked="{Binding FilterNotListed}" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="10,7,0,0" Content="Unreviewed OCR" IsChecked="{Binding FilterUnreviewedOcr}" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="10,7,0,0" Content="Missing" IsChecked="{Binding FilterMissing}" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="10,7,0,0" Content="Hide currently listed" IsChecked="{Binding HideCurrentlyListed}" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="10,7,0,0" Content="Hide listed/sold" IsChecked="{Binding HideFinishedListings}" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="10,7,0,0" Content="Hide done tags" IsChecked="{Binding HideDoneTags}" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="10,7,0,0" Content="Workflow sort" IsChecked="{Binding UseWorkflowSort}" Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Margin="10,7,0,0" Content="Hide terms" IsChecked="{Binding HideHiddenMetadataTerms}" Style="{StaticResource ModernCheckBox}"/>
                        <TextBox Width="180" Margin="6,0,0,0" Text="{Binding HiddenMetadataTerms, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                    </WrapPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="1" Margin="3,8,3,0" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
            </Grid>
        </Border>

        <TabControl Style="{StaticResource ModernTabControl}">
            <TabItem Header="Inventory" Style="{StaticResource ModernTabItem}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="390"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="PhotoGrid"
                              Grid.Column="0"
                              ItemsSource="{Binding FilteredRows}"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              SelectionChanged="PhotoGrid_SelectionChanged"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              CanUserResizeColumns="True"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              HeadersVisibility="Column"
                              ColumnHeaderHeight="34"
                              MinRowHeight="32"
                              GridLinesVisibility="Horizontal"
                              Style="{StaticResource ModernDataGrid}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="MinHeight" Value="32"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="6,3"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="180"/>
                            <DataGridTextColumn Header="Item / group" Binding="{Binding ItemName}" Width="180"/>
                            <DataGridTextColumn Header="Code" Binding="{Binding ImageRoleCode}" Width="70"/>
                            <DataGridTextColumn Header="View" Binding="{Binding ViewType}" Width="105"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding ListingStatus}" Width="115"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                            <DataGridTextColumn Header="Subcategory" Binding="{Binding SportOrGame}" Width="120"/>
                            <DataGridTextColumn Header="Player/title" Binding="{Binding PlayerOrTitle}" Width="160"/>
                            <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="70"/>
                            <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="120"/>
                            <DataGridTextColumn Header="Set" Binding="{Binding SetName}" Width="140"/>
                            <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="95"/>
                            <DataGridTextColumn Header="Card #" Binding="{Binding CardNumber}" Width="85"/>
                            <DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="170"/>
                            <DataGridTextColumn Header="OCR %" Binding="{Binding OcrConfidence}" Width="70"/>
                            <DataGridCheckBoxColumn Header="OCR reviewed" Binding="{Binding OcrReviewed}" Width="105"/>
                            <DataGridCheckBoxColumn Header="Duplicate" Binding="{Binding IsDuplicate}" Width="85"/>
                            <DataGridTextColumn Header="Full path" Binding="{Binding FullPath}" Width="320"/>
                            <DataGridCheckBoxColumn Header="Missing" Binding="{Binding IsMissing}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Background="{StaticResource SurfaceBrush}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Bottom"
                                       Text="{Binding SelectedRow.FullPath}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Padding="8"
                                       TextWrapping="Wrap"/>
                            <Border DockPanel.Dock="Bottom"
                                    Background="{StaticResource BackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="16"
                                    Height="355">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="{Binding MetadataSelectionSummary}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,3,8,5" Text="Item / group" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,5" Text="{Binding MetadataItemName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,3,8,5" Text="Category" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,5"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="True"
                                                      ItemsSource="{Binding CategoryOptions}"
                                                      Text="{Binding MetadataCategory, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource ModernComboBox}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,3,8,5" Text="Subcategory" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,5"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="True"
                                                      ItemsSource="{Binding SportOrGameOptions}"
                                                      Text="{Binding MetadataSportOrGame, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource ModernComboBox}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,3,8,5" Text="Player/title" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,5" Text="{Binding MetadataPlayerOrTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,3,8,5" Text="Year" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,5" Text="{Binding MetadataYear, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                            <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,3,8,5" Text="Brand" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,5"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="True"
                                                      ItemsSource="{Binding BrandOptions}"
                                                      Text="{Binding MetadataBrand, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource ModernComboBox}"/>
                                            <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,3,8,5" Text="Set" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,5" Text="{Binding MetadataSetName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                            <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,3,8,5" Text="Card #" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox Grid.Row="7" Grid.Column="1" Margin="0,0,0,5" Text="{Binding MetadataCardNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                            <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,3,8,5" Text="Serial" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox Grid.Row="8" Grid.Column="1" Margin="0,0,0,5" Text="{Binding MetadataSerialNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                            <TextBlock Grid.Row="9" Grid.Column="0" Margin="0,3,8,5" Text="Condition" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox Grid.Row="9" Grid.Column="1" Margin="0,0,0,5" Text="{Binding MetadataCondition, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                            <TextBlock Grid.Row="10" Grid.Column="0" Margin="0,3,8,5" Text="Tags" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox Grid.Row="10" Grid.Column="1" Margin="0,0,0,5" Text="{Binding MetadataTags, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                            <TextBlock Grid.Row="11" Grid.Column="0" Margin="0,3,8,0" Text="Notes" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBox Grid.Row="11" Grid.Column="1"
                                                     MinHeight="42"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     Text="{Binding MetadataNotes, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}"/>
                                            <TextBlock Grid.Row="12" Grid.Column="0" Margin="0,3,8,0" Text="View" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal">
                                                <RadioButton Content="Front" IsChecked="{Binding MetadataViewFront}" GroupName="MetadataViewType" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <RadioButton Content="Rear" Margin="14,0,0,0" IsChecked="{Binding MetadataViewRear}" GroupName="MetadataViewType" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                            <Button Content="Reload fields" Command="{Binding ReloadMetadataEditorCommand}" Style="{StaticResource SecondaryButton}"/>
                                            <Button Content="Apply to selected" Margin="8,0,0,0" Command="{Binding ApplyMetadataToSelectedImagesCommand}" Style="{StaticResource ModernButton}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                            <Grid Margin="8" Background="#222222">
                                <Image x:Name="PreviewImageControl"
                                       Source="{Binding PreviewImage}"
                                       Stretch="Uniform"
                                       ImageFailed="PreviewImage_ImageFailed"/>
                                <Canvas x:Name="OcrSelectionCanvas"
                                        Background="Transparent"
                                        MouseLeftButtonDown="OcrSelectionCanvas_MouseLeftButtonDown"
                                        MouseMove="OcrSelectionCanvas_MouseMove"
                                        MouseLeftButtonUp="OcrSelectionCanvas_MouseLeftButtonUp">
                                    <Rectangle x:Name="OcrSelectionRectangle"
                                               Visibility="Collapsed"
                                               Stroke="#33A1FF"
                                               StrokeThickness="2"
                                               Fill="#3333A1FF"/>
                                </Canvas>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="OCR Review" Style="{StaticResource ModernTabItem}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <Button Content="Run OCR" Command="{Binding OcrSelectedCommand}" Style="{StaticResource ModernButton}"/>
                            <Button Content="OCR highlighted" Command="{Binding OcrHighlightedRegionCommand}" Style="{StaticResource ModernButton}"/>
                            <Button Content="Save review" Command="{Binding SaveOcrReviewCommand}" Style="{StaticResource ModernButton}"/>
                            <Button Content="Save + learn" Command="{Binding SaveOcrAndLearnCommand}" Style="{StaticResource ModernButton}"/>
                            <TextBlock Margin="12,5,0,0" Text="{Binding OcrRegionSummary}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBox Text="{Binding OcrReviewText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 Margin="0,8,8,0"
                                 Style="{StaticResource ModernTextBox}"/>
                    </DockPanel>
                    <DataGrid Grid.Column="1" ItemsSource="{Binding OcrCandidates}" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="70"/>
                            <DataGridTextColumn Header="Conf" Binding="{Binding Confidence}" Width="70"/>
                            <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="140"/>
                            <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Image Editor" Style="{StaticResource ModernTabItem}">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Content="Rotate left" Command="{Binding RotateSelectedLeftCommand}" Style="{StaticResource ModernButton}"/>
                        <Button Content="Rotate right" Command="{Binding RotateSelectedRightCommand}" Style="{StaticResource ModernButton}"/>
                        <Button Content="Crop center" Command="{Binding CropSelectedCenterCommand}" Style="{StaticResource ModernButton}"/>
                        <Button Content="Fine -1" Command="{Binding FineRotateSelectedLeftCommand}" Style="{StaticResource ModernButton}"/>
                        <Button Content="Fine +1" Command="{Binding FineRotateSelectedRightCommand}" Style="{StaticResource ModernButton}"/>
                        <Button Content="Straighten" Command="{Binding StraightenSelectedCommand}" Style="{StaticResource ModernButton}"/>
                        <Button Content="Rerun OCR" Command="{Binding OcrSelectedCommand}" Style="{StaticResource ModernButton}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding EditRows}" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" Margin="0,8,0,0" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Edited" Binding="{Binding Name}" Width="160"/>
                            <DataGridTextColumn Header="Derived copy" Binding="{Binding Value}" Width="*"/>
                            <DataGridTextColumn Header="Operations" Binding="{Binding Detail}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Pricing" Style="{StaticResource ModernTabItem}">
                <DockPanel Margin="8">
                    <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Content="Recalculate selected" Command="{Binding RecalculatePricingCommand}" Style="{StaticResource ModernButton}"/>
                    <DataGrid ItemsSource="{Binding PricingRows}" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" Margin="0,8,0,0" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Metric" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="160"/>
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Lot Builder" Style="{StaticResource ModernTabItem}">
                <DockPanel Margin="8">
                    <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Content="Create lot from selected" Command="{Binding CreateLotFromSelectionCommand}" Style="{StaticResource ModernButton}"/>
                    <DataGrid ItemsSource="{Binding LotRows}" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" Margin="0,8,0,0" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Status" Binding="{Binding Name}" Width="120"/>
                            <DataGridTextColumn Header="Lot" Binding="{Binding Value}" Width="260"/>
                            <DataGridTextColumn Header="Totals" Binding="{Binding Detail}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>