# eBay Hero — API Bridge Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials.

# ─── eBay Developer Credentials ─────────────────────────────────────────────
# Get these from: https://developer.ebay.com/my/keys

EBAY_ENVIRONMENT=sandbox
EBAY_CLIENT_ID=YourAppID-SandboxOrProduction
EBAY_CLIENT_SECRET=SBX-YourCertID
EBAY_RUNAME=YourApp-YourApp-1234-XXXXXXXX

# ─── Database ────────────────────────────────────────────────────────────────
# Absolute path to your eBayHero SQLite database.
# Leave blank to use ebayhero.db next to api_bridge.py
DB_PATH=

# ─── Safety Guard ────────────────────────────────────────────────────────────
# Set to 1 to allow actual eBay listing publication.
# Default is 0 (safe/demo mode — no live listings will be created).
ENABLE_LIVE_LISTING=0
