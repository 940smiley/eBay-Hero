# eBay Hero environment template.
# Copy to `.env` (gitignored) and fill in real values. Never commit secrets.

# ---- eBay environment -------------------------------------------------------
# sandbox keeps you safe while developing; switch to production only when ready.
EBAY_ENVIRONMENT=sandbox
EBAY_MARKETPLACE_ID=EBAY_US

# ---- eBay developer application keyset --------------------------------------
# App ID shown in the eBay developer portal.
EBAY_CLIENT_ID=
# Cert ID (client secret). Treat like a password.
EBAY_CLIENT_SECRET=
# Long-lived user refresh token from the OAuth consent flow.
EBAY_REFRESH_TOKEN=
# RuName (redirect_uri value registered on the keyset).
EBAY_RUNAME=
# Local loopback callback used to capture the authorization code.
EBAY_REDIRECT_URI=http://127.0.0.1:49152/callback

# ---- Licensing / entitlements ----------------------------------------------
# Optional signed license key (EH1.<payload>.<signature>).
EH_LICENSE_KEY=
# Secret used to verify license keys. Server-side / build-time only.
EH_LICENSE_SECRET=
# Comma-separated addon ids to enable: cardops, stamplicity, ai-suite
EH_ADDONS=cardops,stamplicity

# ---- Storage -----------------------------------------------------------------
# Root for the SQLite database, caches, and OCR training data.
EH_OPERATIONS_ROOT=D:\INVENTORY_PHOTO_OPS
# Optional build-output redirection for low-disk machines.
# EA_BUILD_ROOT=D:\WORK\BuildArtifacts\ebay-hero
# NUGET_PACKAGES=D:\WORK\.nuget-packages
